# 复制本文件为 .env（或 PowerShell 的 env.ps1），填入你自己的值
# ⚠️ 真实凭据永远不要提交到仓库

# ---------- 路线一：云端 TTS（需要小米账号） ----------
# 手机号或小米 ID
MI_USER=
# 密码（首次登录后可用 token 替代，见 docs/README.md）
MI_PASS=

# ---------- 路线二：局域网直连（需要设备 token） ----------
# 格式：<设备内网IP>:<32位token>
# 获取方式：Xiaomi Cloud Tokens Extractor
MI_LOCAL=

# ---------- 可选 ----------
# 指定设备名称（多设备时用）
MI_DEVICE=
